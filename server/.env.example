MOCA_ENV=development

# Dual brain — Phase 6b (recommended)
FAST_BRAIN_PROVIDER=cerebras
FAST_BRAIN_MODEL=llama3.1-8b
FAST_BRAIN_API_KEY=your_cerebras_key_here
FAST_BRAIN_BASE_URL=https://api.cerebras.ai/v1

SMART_BRAIN_PROVIDER=nvidia_nim
SMART_BRAIN_MODEL=meta/llama-3.3-70b-instruct
SMART_BRAIN_API_KEY=your_nim_key_here
SMART_BRAIN_BASE_URL=https://integrate.api.nvidia.com/v1

# Single brain fallback (backwards compat — set these if only one provider)
BRAIN_PROVIDER=cerebras
BRAIN_MODEL=llama3.1-8b
BRAIN_API_KEY=your_key_here
BRAIN_BASE_URL=https://api.cerebras.ai/v1

POSTGRES_URL=postgresql://moca:mocapassword@127.0.0.1:5433/mocadb
REDIS_URL=redis://127.0.0.1:6380
MOCA_HOST=0.0.0.0
MOCA_PORT=8000
SHORT_TERM_WINDOW=10
